// Диалоги плагина. Только ASCII: русские тексты ставит код (bleach_ui.cpp).
#include <windows.h>
#include <commctrl.h>
#include "bleach_res.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MODEL DIALOGEX 0, 0, 460, 326
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "BLEACH Rebirth of Souls - Import"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Game", IDC_M_FOLDER_LBL, 7, 9, 50, 8
    EDITTEXT        IDC_M_FOLDER, 60, 7, 250, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Browse", IDC_M_BROWSE, 314, 7, 60, 14
    PUSHBUTTON      "Steam", IDC_M_FIND, 378, 7, 75, 14
    LTEXT           "Quality", IDC_M_QUAL_LBL, 7, 28, 50, 8
    COMBOBOX        IDC_M_QUALITY, 60, 26, 90, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Search", IDC_M_SEARCH_LBL, 156, 28, 36, 8
    EDITTEXT        IDC_M_SEARCH, 195, 26, 115, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Rescan", IDC_M_RESCAN, 314, 26, 60, 14
    LISTBOX         IDC_M_CHARS, 7, 46, 160, 190, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    CONTROL         "", IDC_M_PARTS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 172, 46, 281, 170
    PUSHBUTTON      "Add", IDC_M_ADDFILE, 172, 220, 90, 14
    PUSHBUTTON      "All", IDC_M_ALL, 266, 220, 60, 14
    PUSHBUTTON      "None", IDC_M_NONE, 330, 220, 60, 14
    GROUPBOX        "Options", IDC_M_OPTGROUP, 7, 238, 446, 64
    AUTOCHECKBOX    "Tex", IDC_M_TEX, 15, 250, 80, 10
    AUTOCHECKBOX    "VCol", IDC_M_VCOL, 100, 250, 80, 10
    AUTOCHECKBOX    "Weld", IDC_M_WELD, 185, 250, 80, 10
    AUTOCHECKBOX    "Skin", IDC_M_SKIN, 270, 250, 80, 10
    AUTOCHECKBOX    "Alpha", IDC_M_ALPHA, 355, 250, 95, 10
    LTEXT           "Bones", IDC_M_BONE_LBL, 15, 267, 45, 8
    COMBOBOX        IDC_M_BONESTYLE, 62, 265, 78, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Units", IDC_M_UNITS_LBL, 148, 267, 55, 8
    COMBOBOX        IDC_M_UNITS, 205, 265, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Scale", IDC_M_SCALE_LBL, 292, 267, 50, 8
    COMBOBOX        IDC_M_SCALE, 345, 265, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Attach", IDC_M_ATTACH_LBL, 15, 285, 110, 8
    COMBOBOX        IDC_M_ATTACH, 128, 283, 150, 200, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "LODs", IDC_M_LODS, 292, 285, 155, 10
    LTEXT           "", IDC_M_STATUS, 7, 310, 272, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "Anim", IDC_M_ANIMS, 283, 306, 56, 16
    DEFPUSHBUTTON   "Import", IDOK, 343, 306, 54, 16
    PUSHBUTTON      "Close", IDCANCEL, 401, 306, 52, 16
END

IDD_ANIM DIALOGEX 0, 0, 400, 330
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT | WS_EX_TOOLWINDOW
CAPTION "BLEACH Rebirth of Souls - Animations"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Rig", IDC_A_RIG_LBL, 7, 9, 50, 8
    COMBOBOX        IDC_A_RIG, 60, 7, 240, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh", IDC_A_REFRESH, 305, 7, 88, 14
    LTEXT           "Pack", IDC_A_PACK_LBL, 7, 28, 50, 8
    COMBOBOX        IDC_A_PACK, 60, 26, 240, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Open", IDC_A_OPEN, 305, 26, 88, 14
    LTEXT           "Search", IDC_A_SEARCH_LBL, 7, 47, 50, 8
    EDITTEXT        IDC_A_SEARCH, 60, 45, 240, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_A_COUNT, 305, 47, 88, 8
    LISTBOX         IDC_A_CLIPS, 7, 63, 386, 140, LBS_NOTIFY | LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "Mode", IDC_A_MODE_LBL, 7, 210, 30, 8
    COMBOBOX        IDC_A_MODE, 40, 208, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Euler", IDC_A_ORDER_LBL, 168, 210, 30, 8
    COMBOBOX        IDC_A_ORDER, 200, 208, 50, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "FPS", IDC_A_FPS_LBL, 258, 210, 22, 8
    COMBOBOX        IDC_A_FPS, 282, 208, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Gap", IDC_A_GAP_LBL, 7, 228, 30, 8
    EDITTEXT        IDC_A_GAP, 40, 226, 30, 14, ES_NUMBER
    AUTOCHECKBOX    "Notes", IDC_A_NOTES, 80, 228, 150, 10
    AUTOCHECKBOX    "Append", IDC_A_APPEND, 235, 228, 158, 10
    PUSHBUTTON      "Load", IDC_A_LOAD, 7, 244, 125, 16
    PUSHBUTTON      "All", IDC_A_LOADALL, 137, 244, 125, 16
    PUSHBUTTON      "Bind", IDC_A_BIND, 267, 244, 126, 16
    LTEXT           "Sequences", IDC_A_SEQ_LBL, 7, 264, 200, 8
    LISTBOX         IDC_A_SEQ, 7, 274, 386, 34, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "", IDC_A_STATUS, 7, 314, 326, 10, SS_ENDELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "Close", IDCANCEL, 341, 310, 52, 16
END
